<Project Sdk="Microsoft.NET.Sdk">

  <!-- Trimming and Native AOT: the library must not rely on reflection. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Hubertech.Belgium</PackageId>
    <Authors>Dampsey</Authors>
    <Company>Hubertech</Company>
    <Copyright>Copyright (c) 2026 Dampsey</Copyright>
    <Description>Belgian administrative identifiers and rules for .NET: enterprise number (BCE/KBO), structured communication (OGM/VCS), Belgian IBAN, public holidays and business days. Allocation-free parsing, no dependencies, and validation errors with stable codes and localized messages (English, French, Dutch).</Description>
    <PackageTags>belgium;belgian;bce;kbo;enterprise-number;vat;structured-communication;ogm;vcs;iban;holidays;business-days;validation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Dampsey/Hubertech.Belgium</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Localization (see docs/adr/0003-localization-strategy.md). -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Versioning from Git tags (see docs/adr/0001-versioning-strategy.md). -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hubertech.Belgium.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
